# Pinned dependency manifest for the macOS libmpv build.
#
# SHA256 values are intentionally accepted as SKIP only for sources whose
# upstream project does not publish stable release checksums in one place.
# To enforce a fully locked supply chain, replace SKIP with a 64-byte SHA256
# and run fetch.sh --strict.

DEPS="m4 autoconf automake libtool nasm pkgconf ninja meson zlib freetype fribidi harfbuzz libass lcms2 dav1d zimg uchardet lua libarchive libplacebo ffmpeg mpv"

M4_VERSION="1.4.19"
M4_URL="https://mirrors.kernel.org/gnu/m4/m4-${M4_VERSION}.tar.xz"
M4_SHA256="SKIP"

AUTOCONF_VERSION="2.72"
AUTOCONF_URL="https://mirrors.kernel.org/gnu/autoconf/autoconf-${AUTOCONF_VERSION}.tar.xz"
AUTOCONF_SHA256="SKIP"

AUTOMAKE_VERSION="1.16.5"
AUTOMAKE_URL="https://mirrors.kernel.org/gnu/automake/automake-${AUTOMAKE_VERSION}.tar.xz"
AUTOMAKE_SHA256="SKIP"

LIBTOOL_VERSION="2.4.7"
LIBTOOL_URL="https://mirrors.kernel.org/gnu/libtool/libtool-${LIBTOOL_VERSION}.tar.xz"
LIBTOOL_SHA256="SKIP"

NASM_VERSION="2.16.03"
NASM_URL="https://www.nasm.us/pub/nasm/releasebuilds/${NASM_VERSION}/nasm-${NASM_VERSION}.tar.xz"
NASM_SHA256="SKIP"

PKGCONF_VERSION="2.5.1"
PKGCONF_URL="https://distfiles.ariadne.space/pkgconf/pkgconf-${PKGCONF_VERSION}.tar.xz"
PKGCONF_SHA256="SKIP"

NINJA_VERSION="1.12.1"
NINJA_URL="https://github.com/ninja-build/ninja/archive/refs/tags/v${NINJA_VERSION}.tar.gz"
NINJA_SHA256="SKIP"

MESON_VERSION="1.8.3"
MESON_URL="https://github.com/mesonbuild/meson/releases/download/${MESON_VERSION}/meson-${MESON_VERSION}.tar.gz"
MESON_SHA256="SKIP"

ZLIB_VERSION="1.3.1"
ZLIB_URL="https://zlib.net/fossils/zlib-${ZLIB_VERSION}.tar.gz"
ZLIB_SHA256="SKIP"

FREETYPE_VERSION="2.13.3"
FREETYPE_URL="https://download.savannah.gnu.org/releases/freetype/freetype-${FREETYPE_VERSION}.tar.xz"
FREETYPE_SHA256="SKIP"

FRIBIDI_VERSION="1.0.16"
FRIBIDI_URL="https://github.com/fribidi/fribidi/releases/download/v${FRIBIDI_VERSION}/fribidi-${FRIBIDI_VERSION}.tar.xz"
FRIBIDI_SHA256="SKIP"

HARFBUZZ_VERSION="14.2.1"
HARFBUZZ_URL="https://github.com/harfbuzz/harfbuzz/releases/download/${HARFBUZZ_VERSION}/harfbuzz-${HARFBUZZ_VERSION}.tar.xz"
HARFBUZZ_SHA256="SKIP"

LIBASS_VERSION="0.17.5"
LIBASS_URL="https://github.com/libass/libass/releases/download/${LIBASS_VERSION}/libass-${LIBASS_VERSION}.tar.xz"
LIBASS_SHA256="SKIP"

LCMS2_VERSION="2.19"
LCMS2_URL="https://github.com/mm2/Little-CMS/releases/download/lcms${LCMS2_VERSION}/lcms2-${LCMS2_VERSION}.tar.gz"
LCMS2_SHA256="SKIP"

DAV1D_VERSION="1.5.1"
DAV1D_URL="https://code.videolan.org/videolan/dav1d/-/archive/${DAV1D_VERSION}/dav1d-${DAV1D_VERSION}.tar.gz"
DAV1D_SHA256="SKIP"

ZIMG_VERSION="3.0.6"
ZIMG_URL="https://github.com/sekrit-twc/zimg/archive/refs/tags/release-${ZIMG_VERSION}.tar.gz"
ZIMG_SHA256="SKIP"

UCHARDET_VERSION="0.0.8"
UCHARDET_URL="https://www.freedesktop.org/software/uchardet/releases/uchardet-${UCHARDET_VERSION}.tar.xz"
UCHARDET_SHA256="SKIP"

LUA_VERSION="5.2.4"
LUA_URL="https://www.lua.org/ftp/lua-${LUA_VERSION}.tar.gz"
LUA_SHA256="SKIP"

LIBARCHIVE_VERSION="3.8.2"
LIBARCHIVE_URL="https://github.com/libarchive/libarchive/releases/download/v${LIBARCHIVE_VERSION}/libarchive-${LIBARCHIVE_VERSION}.tar.xz"
LIBARCHIVE_SHA256="SKIP"

LIBPLACEBO_VERSION="7.360.1"
LIBPLACEBO_GIT_URL="https://github.com/haasn/libplacebo.git"
LIBPLACEBO_REF="v${LIBPLACEBO_VERSION}"
LIBPLACEBO_SHA256="SKIP"

FFMPEG_VERSION="8.1.2"
FFMPEG_URL="https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz"
FFMPEG_SHA256="SKIP"

MPV_DEFAULT_VERSION="0.41.0"
MPV_REF="${MPV_REF:-v${MPV_DEFAULT_VERSION}}"
MPV_VERSION="${MPV_REF#v}"
MPV_VERSION="${MPV_VERSION//\//-}"
MPV_URL="https://github.com/mpv-player/mpv/archive/${MPV_REF}.tar.gz"
MPV_SHA256="SKIP"
